FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      C_OH;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 -3 0 0 1 0 0];

internalField   uniform 1000;

boundaryField
{

    "inlet_(.*)"
    {
    	type		fixedValue;
    	value		uniform 1000;
    }

    "outlet_(.*)"
    {
        type            zeroGradient;
        inletValue      $internalField;
    }

    "wall.*"
    {
	type 		zeroGradient;
        //	type 		zeroGradient;
    }
    
}


// ************************************************************************* //
