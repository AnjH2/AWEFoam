// ---------------------------------
// symmetric layers: ratio-controlled
// ---------------------------------

gradZ23
(
    (0.5 0.5 $rMid23)
    (0.5 0.5 #eval{1.0/$rMid23})
);

gradZ01
(
    (0.5 0.5 $rMid01)
    (0.5 0.5 #eval{1.0/$rMid01})
);

gradZ45 $gradZ01;

// ---------------------------------
// half-block sizes for symmetric layers
// ---------------------------------

mZ01 #eval{$n_z01/2};
mZ23 #eval{$n_z23/2};

cr0 #eval{pow($rMid01,1.0/($mZ01-1))};
wA0 #eval{0.5*$L_z01*(1-$cr0)/(1-pow($cr0,$mZ01))};

cr2 #eval{pow($rMid23,1.0/($mZ23-1))};
wA2 #eval{0.5*$L_z23*(1-$cr2)/(1-pow($cr2,$mZ23))};

r1 #eval{$wA0/$wA2};
c12 #eval{pow($r1,1.0/($n_z12-1))};
L12check #eval{$wA0*(1-pow($c12,$n_z12))/(1-$c12)};
err12 #eval{$L12check/$L_z12};

c34 #eval{pow(1.0/$r1,1.0/($n_z34-1))};
L34check #eval{$wA2*(1-pow($c34,$n_z34))/(1-$c34)};
err34 #eval{$L34check/$L_z34};

gradZ12
(
    (0.5 0.5 $r1)
    (0.5 0.5 #eval{1.0/$r1})
);
gradZ34
(
    (0.5 0.5 $r1)
    (0.5 0.5 #eval{1.0/$r1})
    
);



