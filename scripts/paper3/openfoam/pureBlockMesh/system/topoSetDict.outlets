    // cells directly attached to patch "Walls"
/*
{
    name    wallNearCells;
    type    cellSet;
    action  new;
    source  patchToCell;
    patch   Walls;
}
*/
{
    name    cutAngleCells;
    type    cellSet;
    action  new;
    source  rotatedBoxToCell;

    origin  (0 0 #eval{$z0});
    i       (#eval{$x1} #eval{-$y1}  0);
    j       (#eval{$x3} #eval{$y3}  0);
    k       (0 0 #eval{($z5-$z0)});
}
{
    name    cutAngleCells;
    type    cellSet;
    action  add;
    source  rotatedBoxToCell;

    origin  (0 0 #eval{$z5});
    i       (#eval{-$x1} #eval{-$y1}  0);
    j       (#eval{-$x3} #eval{$y3}  0);
    k       (0 0 #eval{($z0-$z5)});
}
{
    name    wallNearCells;
    type        cellSet;
    action      new;

    // Mandatory entries
    source      cylinderToCell;
    p1          (0 0 $z0);
    p2          (0 0 $z5);
    radius      1000;

    // Optional entries
    innerRadius #eval{$R1*0.95*1e-3};
}
{
    name    wallNearCells;
    type    cellSet;
    action  subtract;
    source  cellToCell;
    set     cutAngleCells;
}

// +1 layer away from wall
{
    name    wallNearCells;
    type    cellSet;
    action  add;
    source  haloToCell;
    
     steps       5;
}
