*/
{
    name    cutAngleCells;
    type    cellSet;
    action  new;
        // Mandatory entries
        source      boxToCell;

        // Conditional mandatory entries
        // Select either of the below

        // Option-2 
        boxes (
                (#eval{-sin(degToRad(42))*$R1*1e-3} #eval{cos(degToRad(42))*$R1*1e-3} #eval{$z0*1e-3})(#eval{sin(degToRad(42))*$R1*1e-3}  #eval{$yout*1e-3} #eval{$z5*1e-3})
                (#eval{-sin(degToRad(24))*$R1*1e-3} #eval{-cos(degToRad(24))*$R1*1e-3} #eval{$z0*1e-3})(#eval{sin(degToRad(24))*$R1*1e-3} #eval{$yout*1e-3} #eval{$z5*1e-3})
              );
    }

