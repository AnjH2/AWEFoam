FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      C_H2;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 -3 0 0 1 0 0];

internalField   uniform 0.001;

boundaryField
{


    "inlet_(.*)"
    {
    	type		fixedValue;
    	value		uniform 0.001;
    }

    "outlet_(.*)"
    {
        type            inletOutlet;
        value		    $internalField;
        inletValue      $internalField;
    }

    "wall(.*)"
    {
	type 		zeroGradient;
        //type 		zeroGradient;
    }
    
}


// ************************************************************************* //
