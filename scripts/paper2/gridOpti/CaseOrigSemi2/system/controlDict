FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     currentTransport;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         15;

deltaT          0.0005;

writeControl    adjustableRunTime;

writeInterval   1;

purgeWrite      3;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep 	yes;
maxCo 		0.4;
maxDeltaT	0.05;


functions
{
	
	
	
	planeAvg
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        enabled         true;

        // --- what to compute
        operation       areaAverage;
        fields          (Ie Ue);          // U = vector avg; Umag = scalar avg

        // --- define the plane (sampled surface)
        regionType      faceZone;
        name            midPlaneZone; 

        // --- when/how to write
	    writeControl    runTime;
	    writeInterval   1;                 // every step; change as you like
        surfaceFormat  none;               // no full surface dump, just the stats
        writeFields    false;              // don’t write sampled fields on the plane
        writeToFile    true;               // writes values to postProcessing/planeAvg/...
    }
	planeNeAvg
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        enabled         true;

        // --- what to compute
        operation       areaAverage;
        fields          (UNe);          // U = vector avg; Umag = scalar avg

        // --- define the plane (sampled surface)
        regionType      faceZone;
        name            NePlaneZone;          // label for the plane in outputs


        // --- when/how to write
	    writeControl    runTime;
	    writeInterval   1;                 // every step; change as you like
        surfaceFormat  none;               // no full surface dump, just the stats
        writeFields    false;              // don’t write sampled fields on the plane
        writeToFile    true;               // writes values to postProcessing/planeAvg/...
    }    
    line
    {
        type            sets;
        libs            (sampling);
        enabled         true;
	    writeControl    runTime;
	    writeInterval   1;

        interpolationScheme cellPoint;
        setFormat       raw;

        fields          (alpha.gas);

        sets
        {

            s10
            {
                type            midPoint;
                axis            distance;
                start           ( 10e-3 -1.8e-3 15e-3 );
                end             ( 10e-3 6.25e-3 15e-3 );
            }

            s30
            {
                type            midPoint;
                axis            distance;
                start           ( 30e-3 -1.8e-3 15e-3 );
                end             ( 30e-3 6.25e-3 15e-3 );
            }

            s50
            {
                type            midPoint;
                axis            distance;
                start           ( 50e-3 -1.8e-3 15e-3 );
                end             ( 50e-3 6.25e-3 15e-3 );
            }
        }	
	}
}
