FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      C_OH;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 -3 0 0 1 0 0];

internalField   uniform COHE;

boundaryField
{
    PPe
    {
	type		zeroGradient;
    }
    PNe
    {
	type		zeroGradient;
    }

    frontAndBack
    {
	type		empty;
    }

    Inlet1
    {
    	type		fixedValue;
    	value		uniform COHE;
    }
    Inlet2
    {
    	type		fixedValue;
    	value		uniform COHE;
    }
    Outlet1
    {
        type            zeroGradient;
    }
    Outlet2
    {
        type            zeroGradient;
    }
        OWall
    {
	type 		zeroGradient;
        
    }
    Walls
    {
	type 		zeroGradient;
        //	type 		zeroGradient;
    }
    
}


// ************************************************************************* //
