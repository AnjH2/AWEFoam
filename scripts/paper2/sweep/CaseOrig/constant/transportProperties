FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
RDB_Ne		0.05e-3;
RDB_Pe		0.075e-3;
phases          (gas electrolyte);

gas
{
    transportModel  Beckermann;

    rho             0.0645;
    nud		    1.44e-4;
    mu		    1e-5;
    
    //related to diffusion between phases.
    zeta	1;
    C_star	1; //rigid spheres
    Da		0.16;
    Db		0.81;
    D1_ref	1.213e-4;//depends on temperature and pressure. needs to be added at some point.
    waterVapour 	true;
    "(Beckermann|Ishii|linearMu)Coeffs"
    {
    
    
    
    mu_ref_H2		    8.411e-6;
    mu_ref_O2		    1.919e-5;
    mu_ref_H2O		    9.81e-6;
    
    T_muref_H2		    273.15;
    T_muref_O2		    300;	//273.15
    T_muref_H2O		    300;
    
    n_mu_H2		    0.67;
    n_mu_O2		    0.754;
    n_mu_H2O		    1.1;
    
    //Ishii
    alpha_crit	    1;
    //Beckermann
    kr_Ne		1.25;//BECKKR;
    kr_Pe       1.25;
    kr_Mem      3;
    }
}

electrolyte
{
    	transportModel  Newtonian;

    	nu              1.6e-06;
    	rho             1231;
    	mu		1.968e-3;
}

capillaryPressureModel noPc;

"(leverett|noPc)Coeffs"
{

    sigma   72;
    thetaDeg    15;
    alphaWetMin 0;
    alphaWetMax 0.5;
}

pore:RelativeVelocityModel stuckBubbles;//viscousRegime;//simpleIshii;//
free:RelativeVelocityModel SchillingsU;

"free:(combined|combinedDiffusion|combinedME|combinedFixedD|stokes|SchillingsU)Coeffs"
{
    hF          0;//how much the velocity is reduced, 0 is free rasing bubble, only active in Pe and Ne
    rd_Ne		$RDB_Ne;
    rd_Pe		$RDB_Pe;
    R_DB_Ne        $RDB_Ne;
    R_DB_Pe        $RDB_Pe;
    
    
    n               	5;//2.4;
    minAlphad		1;
    

    free:phaseDiffusionModel Schillings;
    "(constant|noDiffusion|Ishii|Schillings)Coeffs"
    {
        DiffusionConstant   1e-6;
        dF          1;//how much the dispersion is incressed, 1 is defined dispersion, only active in Pe and Ne
        
        //---Schillings---
        n                   5;
        diffCoeffGravity    8;
        diffCoeffGravityNormal  1;
        bubbleRadius_Ne    $RDB_Ne;
        bubbleRadius_Pe    $RDB_Pe;
    }
    
}


"pore:stuckBubblesCoeffs"
{
    //thetaScale*as_*R_DB*coverageModel^thetaInvPowN
    thetaScale_Ne   _C_C_NE_;
    thetaScale_Pe   _C_C_PE_;
    thetaInvPowN   1; 
    rd_Ne		$RDB_Ne;
    rd_Pe		$RDB_Pe;
    baseModel   
    {
        pore:base:RelativeVelocityModel stokes; //represents the moveing bubbles
     "pore:base:stokesCoeffs"
        {
            hF          2;//how much the velocity is reduced, 0 is free rasing bubble, only active in Pe and Ne
            rd_Ne		$RDB_Ne;
            rd_Pe		$RDB_Pe;
            n              	5;//2.4;
            minAlphad		1;
            
            pore:base:phaseDiffusionModel solidPressure;
            "(constant|Ishii|Schillings|simpleP|BearScheidegger|solidPressure)Coeffs"
            {
                
                dF          1;//how much the dispersion is incressed, 1 is defined dispersion, only active in Pe and Ne
                
                slopeGrowth_Ne SSGGNNEE;
                scale_Ne   SSNNEE;
                slopeGrowth_Pe SSGGPPEE;
                scale_Pe   SSPPEE;
                diffusionOffset DDOO;
                //---Schillings---
                diffCoeffGravity    1;
                diffCoeffGravityNormal  1;
                bubbleRadius_Ne    $RDB_Ne;
                bubbleRadius_Pe    $RDB_Pe;
            }
        }
    }
    covModel
    {
        coverageModel verticalVogt;
        J_lim		300000.0;
        J_scale		1;
        Temperature_ref	298.15;
        bubbleDragCoefficient_Ne _C_D_NE_; //in the order of 64
        bubbleDragCoefficient_Pe _C_D_PE_;
        
    }
    

    pore:phaseDiffusionModel noDiffusion; //represents the static bubbles
    "(constant|noDiffusion|Ishii|Schillings|simple|simpleP|capillaryD)Coeffs"
    {

    }
}

coverageModel linearVerticalVogt;

"(linearCoverage|vogt|linearVogt|bubbleNeuclation|bubbleNeuclationLinear|zeroCoverage|linearVerticalVogt)Coeffs"
{
	//vogt
        J_lim		300000.0;
        J_scale		1;
        Temperature_ref	298.15;
        //vertical vogt extra
        
        bubbleDragCoefficient_Ne _C_D_NE_; //in the order of 64
        bubbleDragCoefficient_Pe _C_D_PE_;
    // linear    
	n		1;	//power of linear coverage
}

concentrationLossModel constantRatio;

"(constantRatio|fixedReferenceValue|localReference)Coeffs"
{
stoichiometricCoefficient true; //use stoichiometricCoefficient as exponent CR[i]^n.:=
//used in "constantRatio"

//used in "fixedReferenceValue"
	C_ref_OH 	6851.19;
	C_ref_H2O 	48810;
	C_ref_H2 	1;
	C_ref_O2 	1;
	//exponent, CR[i]^n, all have to be specified, even when not truely used.
	n_Ne_H2		1;
	n_Ne_O2		1;
	n_Ne_H2O	2;
	n_Ne_OH		2;
	a_Ne		("H2");
	c_Ne		("H2O");
	
	
	n_Pe_H2		1;
	n_Pe_O2		0.5;
	n_Pe_H2O	1;
	n_Pe_OH		2;
	a_Pe		("OH");
	c_Pe		("O2");
	
}


speciesTransport
{
	wireModel	constantSherwood;
	
	"wireModel_generalCoeffs"
	{
		
		a	1.1;
		b	0.43;
		c	0.33;
		d_Ne	0.06e-3;
		d_Pe	0.06e-3;
		
	}
	"wireModel_constantSherwoodCoeffs"
	{
		
		sh_H2	100;
		sh_O2	100;
		sh_H2O	100;
		sh_OH	100;
		d_Ne	0.06e-3;
		d_Pe	0.06e-3;
		
	}

}

massAndSpeciesTransferModel mixedSaturation;
"(surfaceSaturation|mixedSaturation|bulkSaturation)Coeffs"
{

	

	waterVapour 	true;
	m_KOH		7.65; //[mol/kg] 7.65-> 30wt%	
	
	AttachedBubbleGrowthModel	constantSherwood;
	"AttachedBubbleGrowthModel_constantSherwoodCoeffs"
		{
		
		sh_H2	0;
		sh_O2	0;
		sh_H2O	0;
		sh_OH	0;
		d_Ne	#eval{$RDB_Ne/2};
		d_Pe	#eval{$RDB_Pe/2};
		
	}
	"AttachedBubbleGrowthModel_(generalR|general)Coeffs"
	{
		
		a	1.1;
		b	0.43;
		c	0.33;
		d_Ne	#eval{$RDB_Ne/2};
		d_Pe	#eval{$RDB_Pe/2};
		
	}
	DetachedBubbleGrowthModel	constantSherwood;
	"DetachedBubbleGrowthModel_constantSherwoodCoeffs"
	{
		sh_H2	10;
		sh_O2	10;
		sh_H2O	0;
		sh_OH	0;
		d_Ne	$RDB_Ne;
		d_Pe	$RDB_Pe;
	}
	"DetachedBubbleGrowthModel_(WhitakerR|Whitaker)Coeffs"
	{

		d_Ne	$RDB_Ne;
		d_Pe	$RDB_Pe;
	}
	
	tau_c	0.01;
	tau_b	0.1;
	c_AB	4;//4//163; //angle=9deg
	K_DB	0;
	K_AB	0;
	R_DB	$RDB_Ne;
	/*c_AB_H2	100;//163; //angle=9deg
	c_AB_O2	100;//163; //angle=9deg
	K_DB_H2	3.71e-4;
	K_DB_O2	1.479e-4;
	K_AB_H2	1.283e-4;
	K_AB_O2	4.314e-5;
	R_DB_H2	0.5e-3;
	R_DB_O2	0.5e-3;*/
	a	1;	//mixing constant (a*C-C_sat)

}
p_num		101325;
T0		298; //reference temperature
mu_KOH		0.000581;	//extrapolated to 80C with data from from https://link.springer.com/content/pdf/10.1134/S0018151X20060127.pdf?pdf=button%20sticky (checked 23/01-2023)
Re_p		6.32;

//mole weight
MW_H2		2.01588e-3;	//kg/mol
MW_O2		31.9988e-3;	//kg/mol
MW_OH		17.007e-3;	//kg/mol
MW_H2O		18.01528e-3;	//kg/mol
MW_K		39.10e-3;	//kg/mol

// iterations to correct potentials and species
potentialCorrections	5;
speciesCorrections	2;

//other
n_Temp	0;

