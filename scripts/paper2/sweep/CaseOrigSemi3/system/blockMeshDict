scale   1e-3;



Ny		60.0;
Nz		1;
tPe		1.8;
tDi		0.85;
tNe		1.8;
tC_      1.8;
cellLength	100;
cellDepth	30;
inletL		5;
outletL		5;

S1 5;
SDi	1.2;
SC	0.5;

t01 #eval #{ -$tC_ #};
t2 #eval #{ $tPe+$tDi #};
t3 #eval #{ $tPe+$tDi+$tNe #};
t4 #eval #{ $t3+$tC_ #};
inletx #eval #{ -1*$inletL #};
outletx	#eval #{ $cellLength+$outletL #};


dyPe	9.810614353358806;
dyNe	9.810614353358806;
dyPeD	9.810614353358806;
dyNeD	9.810614353358806;
dyPeC	1.5;
dyNeC	1.5;
RC      0.3;
RD      #eval #{ 1-$RC #};

dyDiNe	7.0019734877704085;	
dyDiPe	7.0019734877704085;

dx	1;
dyC 2;


Nx  #eval #{ round($cellLength/($t3*$S1) *$Ny) #};
NInlet  #eval #{ round($inletL/($t3*$S1) *$Ny) #};
NOutlet  #eval #{ round($outletL/($t3*$S1) *$Ny) #};


NyPE #eval #{ round($tPe/($t3)*$Ny) #};
NyNE #eval #{ round($tNe/($t3)*$Ny) #};
NyD #eval #{ round($tDi/($t3)*$Ny*$SDi) #};
NC #eval #{ round($tC_/($t3)*$Ny*$SC) #};
