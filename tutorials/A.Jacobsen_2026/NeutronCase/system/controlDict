FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     alkaWEFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         10;

deltaT          0.0005;

writeControl    adjustableRunTime;

writeInterval   0.2;

purgeWrite      3;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep 	yes;
maxCo 		0.9;
maxDeltaT	0.05;

libs ( "libpidUNeBC.so" );

functions
{

	PWall_Ne
	{
	name    PNe;
	fields  (INe UNe);

	operation areaAverage;

	type            surfaceFieldValue;
	libs            ("libfieldFunctionObjects.so");

	writeControl    runTime;
	writeInterval   0.2;

	writeFields     false;
	log             false;

	regionType  patch;
	}
	PWall_Pe
	{
	name    PPe;
	fields  (IPe UPe);

	operation areaAverage;

	type            surfaceFieldValue;
	libs            ("libfieldFunctionObjects.so");

	writeControl    runTime;
	writeInterval   0.2;

	writeFields     false;
	log             false;

	regionType  patch;
	}
	
	line
    {
        type            sets;
        libs            (sampling);
        enabled         true;
	    writeControl    runTime;
	    writeInterval   0.2;

        interpolationScheme cellPoint;
        setFormat       raw;

        fields          (alpha.gas);

        sets
        {

            s10
            {
                type            midPoint;
                axis            distance;
                start           ( 10e-3 0 15e-3 );
                end             ( 10e-3 4.45e-3 15e-3 );
            }

            s30
            {
                type            midPoint;
                axis            distance;
                start           ( 30e-3 0 15e-3 );
                end             ( 30e-3 4.45e-3 15e-3 );
            }

            s50
            {
                type            midPoint;
                axis            distance;
                start           ( 50e-3 0 15e-3 );
                end             ( 50e-3 4.45e-3 15e-3 );
            }

        }	
	}
}
