FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

tPe		1.8e-3;
tDi		0.85e-3;
tNe		1.8e-3;
cellLength	100.0e-3;
cellDepth	30e-3;
nD		0.025;
inletL		5;
outletL		5;

t2 #eval #{ $tPe+$tDi #};
t3 #eval #{ $tPe+$tDi+$tNe #};
inletx #eval #{ -1*$inletL #};
outletx	#eval #{ $cellLength+$outletL #};

L0 #eval #{ $cellLength*0.05 #};

V1Ne1 #eval #{ $t2+$tNe*$nD #};
V1Ne2 #eval #{ $t3-$tNe*$nD #};
V1Pe1 #eval #{ $tPe*$nD #};
V1Pe2 #eval #{ $tPe-$tPe*$nD #};


defaultFieldValues
(
    //volScalarFieldValue sigma_s 1000
    volScalarFieldValue r_p 2e-05
