NOutlet  #eval #{ round($outletL/($t3*$S1) *$Ny) #};


NyPE #eval #{ round($tPe/($t3)*$Ny) #};
NyNE #eval #{ round($tNe/($t3)*$Ny) #};
NyD #eval #{ round($tDi/($t3)*$Ny*$SDi) #};

