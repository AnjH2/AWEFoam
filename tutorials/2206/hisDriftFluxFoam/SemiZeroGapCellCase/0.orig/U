FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0.0309 0 0);//200ml/min


boundaryField
{
    PNe
    {
        type            noSlip;
    }
    PPe
    {
        type            noSlip;
    }
    frontAndBack
    {
	type		empty;
    }
    Inlet
    {
    	//type	zeroGradient;
        type            fixedValue;
        value		$internalField;
        //type	flowRateInletVelocity;
        //volumetricFlowRate constant 0.833e-6;
        //type 			fixedMean;
        //meanValue		constant (VEX VEY VEZ);
        //value			$internalField;
    }

    Outlet
    {
        type            inletOutlet;
        value		uniform (0 0 0);
        inletValue	uniform (0 0 0);
    }

    Wall
    {
            type            noSlip;
    	//type	zeroGradient;
        //type            fixedValue;
        //value		$internalField;
        //type	flowRateInletVelocity;
        //volumetricFlowRate constant 1e-4;
    }
    
}


