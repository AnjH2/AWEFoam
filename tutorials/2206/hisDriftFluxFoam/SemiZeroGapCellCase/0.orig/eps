FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      eps;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.5; 


boundaryField
{
    PNe
    {
        type            fixedValue;
        value           uniform 0.97;
    }
    PPe
    {
        type            fixedValue;
        value           uniform 0.97;
    }
    frontAndBack
    {
        type            empty;
    }
    Outlet
    {
        type            zeroGradient;
    }

    Inlet
    {
        type            fixedValue;
        value           uniform 0.97;
    }


    Wall
    {
        type            fixedValue;
        value           uniform 0.5;
    }
}


