FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      V2;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1;


boundaryField
{
    PNe
    {
        type            fixedValue;
        value		uniform 0;
    }
    PPe
    {
        type            fixedValue;
        value		uniform 0;
    }
    frontAndBack
    {
	type		empty;
    }
    Inlet
    {
	type            zeroGradient;
    }

    Outlet
    {
        type            zeroGradient;
    }


    Wall
    {
        type            fixedValue;
        value		uniform 0;
    }
    
}


