FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      UNe;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 2 -3 0 0 -1 0];

internalField   uniform -1.4;



boundaryField
{
    PNe
    {
        type            uniformFixedValue;
        uniformValue 	table
        (
        (0 -1.4)
	//(0.5 -1.5)(5 -1.5)(5.5 -1.6)(10 -1.6)(10.5 -1.7)(15 -1.7)(15.5 -1.8)(20 -1.8)(20.5 -1.9)(25 -1.9)(25.5 -2.0)(30 -2.0)
	(0.25 -1.4)(2 -2.6)
        );
    }
    PPe
    {
	type		zeroGradient;
    }

    frontAndBack
    {
	type		empty;
    }
    Inlet
    {
    	type		zeroGradient;
    }

    Outlet
    {
        type            zeroGradient;
    }

    Wall
    {
	type 		zeroGradient;
    }
    
}


