    	(
    		volScalarFieldValue C_O2.gas 0
    	);
    }
        boxToCell
    {
    	box (0 $tPe 0) ($cellLength  $t2 $cellDepth);
    	
    	fieldValues
    	(
    		volScalarFieldValue C_H2O.gas 0
    	);
    }*/
);


